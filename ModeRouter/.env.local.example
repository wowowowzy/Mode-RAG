# 复制为 .env.local 后填入真实值（.env.local 已被 gitignore）。
#
# 整个仓库只需要配这一份：ModeTest/application.yml 会通过
# ../ModeRouter/.env.local 读它，所以 ModeTest 不必再建一份。
# 两者的差别只有 OPENAI_MODEL 一项 —— 它只被 ModeTest 读取。

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=

# 执行模型，仅 ModeTest 使用（ModeRouter 不读这个键）。
# 换模型改这里即可，改完重启 ModeTest。
OPENAI_MODEL=qwen3.7-flash

# 本地精判引擎，默认即可
JEV_BASE_URL=http://127.0.0.1:8765
